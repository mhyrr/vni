<Layouts.app flash={@flash} active={:districts}>
  <section class="commit-page editorial-shell grid min-h-[calc(100vh-72px)] bg-[var(--green)] lg:grid-cols-[0.78fr_1.22fr]">
    <div class="border-b-2 border-[var(--ink)] lg:border-r-2 lg:border-b-0">
      <div class="section-pad lg:sticky lg:top-[72px]">
        <p class="eyebrow">Your seat</p>
        <h1 class="display-lg mt-6">{@district.label}</h1>

        <div :if={@district.incumbent_name} class="mt-9 border-t-2 border-[var(--ink)] pt-6">
          <p class="data-label">Currently held by</p>
          <p class="mt-3 font-serif text-3xl leading-tight">
            {@district.incumbent_name}
            <span :if={@district.incumbent_party}>({@district.incumbent_party})</span>
          </p>
          <p :if={@district.incumbent_since} class="mt-2 text-sm leading-6">
            In office since {@district.incumbent_since}.
          </p>
        </div>

        <div class="mt-8 border-t-2 border-[var(--ink)] pt-6">
          <p class="data-label">Committed here so far</p>
          <p class="display-md mt-3">{@count}</p>
          <p class="mt-3 text-sm leading-6">
            <%= case @district.commitment_goal_basis do %>
              <% :unopposed -> %>
                Nobody ran against this seat last time. Before it needs votes, it needs an opponent.
              <% :margin -> %>
                Next target {@target}. This seat was decided by {@district.last_margin_votes} votes.
              <% :unknown -> %>
                Next target {@target}.
            <% end %>
          </p>
        </div>

        <p class="mt-10 max-w-sm text-sm leading-6">
          We publish how many people committed in each district. We never publish who they are.
        </p>

        <.link navigate={~p"/districts/#{@district.slug}"} class="paper-button mt-9">
          Back to the district <span aria-hidden="true">↗</span>
        </.link>
      </div>
    </div>

    <div class="section-pad bg-[var(--paper)]">
      <div :if={@sent_to} id="commitment-sent">
        <p class="eyebrow">One more step</p>
        <h2 class="display-md mt-6">Check your email.</h2>
        <p class="mt-8 max-w-2xl font-serif text-2xl leading-tight">
          We sent a link to <strong>{@sent_to}</strong>. Until you click it, you are not counted.
        </p>
        <p class="mt-7 max-w-xl text-sm leading-6">
          That is deliberate. A number anybody could inflate by typing addresses would not be
          worth publishing, so nothing counts until someone confirms they can read the mail.
        </p>
      </div>

      <form :if={is_nil(@sent_to)} phx-change="validate" phx-submit="submit" id="commitment-form">
        <p class="eyebrow">Question 01 / 03</p>
        <h2 class="mt-6 max-w-4xl font-serif text-4xl leading-[1.02] md:text-5xl">
          Will you vote against {@district.incumbent_name || "this incumbent"} in November,
          whoever runs?
        </h2>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          <label
            :for={
              {value, letter, label} <- [
                {"yes", "A", "Yes."},
                {"conditional", "B", "Only if others do."},
                {"no", "C", "No."}
              ]
            }
            class={[
              "action-choice block cursor-pointer",
              @params["commitment"] == value && "is-selected"
            ]}
          >
            <input
              type="radio"
              name="commitment[commitment]"
              value={value}
              checked={@params["commitment"] == value}
              class="sr-only"
            />
            <span class="data-label">{letter}</span>
            <strong class="mt-5 block text-2xl font-black tracking-[-0.06em]">{label}</strong>
          </label>
        </div>
        <p :if={@errors[:commitment]} class="mt-4 text-sm font-bold">{@errors[:commitment]}</p>

        <div class="mt-14 border-t-2 border-[var(--ink)] pt-9">
          <p class="eyebrow">Question 02 / 03</p>
          <h3 class="mt-5 font-serif text-2xl leading-tight md:text-3xl">
            Did you vote for {@district.incumbent_name || "them"} last time?
          </h3>
          <div class="mt-6 flex flex-wrap gap-3">
            <label
              :for={
                {value, label} <- [
                  {"yes", "Yes"},
                  {"no", "No"},
                  {"unsure", "Don't remember"}
                ]
              }
              class={[
                "cursor-pointer border-2 border-[var(--ink)] px-5 py-3 text-sm font-black uppercase tracking-wide",
                @params["voted_for_incumbent"] == value && "bg-[var(--ink)] text-white"
              ]}
            >
              <input
                type="radio"
                name="commitment[voted_for_incumbent]"
                value={value}
                checked={@params["voted_for_incumbent"] == value}
                class="sr-only"
              />
              {label}
            </label>
          </div>
        </div>

        <div class="mt-12 border-t-2 border-[var(--ink)] pt-9">
          <p class="eyebrow">Question 03 / 03</p>
          <h3 class="mt-5 font-serif text-2xl leading-tight md:text-3xl">
            What party are you in now?
          </h3>
          <div class="mt-6 flex flex-wrap gap-3">
            <label
              :for={
                {value, label} <- [
                  {"republican", "Republican"},
                  {"democrat", "Democrat"},
                  {"independent", "Independent"},
                  {"other", "Other"},
                  {"declined", "Rather not say"}
                ]
              }
              class={[
                "cursor-pointer border-2 border-[var(--ink)] px-5 py-3 text-sm font-black uppercase tracking-wide",
                @params["party"] == value && "bg-[var(--ink)] text-white"
              ]}
            >
              <input
                type="radio"
                name="commitment[party]"
                value={value}
                checked={@params["party"] == value}
                class="sr-only"
              />
              {label}
            </label>
          </div>
          <p class="mt-5 max-w-xl text-sm leading-6">
            We publish the split, never the people. It is the only way to show this coalition
            crosses party lines instead of asserting it.
          </p>
        </div>

        <div class="mt-12 border-t-2 border-[var(--ink)] pt-9">
          <label for="keep_vote_answer" class="eyebrow">Optional</label>
          <h3 class="mt-5 font-serif text-2xl leading-tight">
            What would it take for {@district.incumbent_name || "them"} to keep your vote?
          </h3>
          <textarea
            id="keep_vote_answer"
            name="commitment[keep_vote_answer]"
            rows="3"
            maxlength="2000"
            class="mt-6 w-full border-2 border-[var(--ink)] bg-[var(--paper-bright)] p-4 font-serif text-lg"
          >{@params["keep_vote_answer"]}</textarea>
        </div>

        <div class="mt-12 border-t-2 border-[var(--ink)] pt-9">
          <label for="email" class="eyebrow">Your email</label>
          <input
            type="email"
            id="email"
            name="commitment[email]"
            value={@params["email"]}
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="mt-5 w-full max-w-xl border-2 border-[var(--ink)] bg-[var(--paper-bright)] p-4 text-lg"
          />
          <p :if={@errors[:email]} class="mt-3 text-sm font-bold">{@errors[:email]}</p>
          <p class="mt-4 max-w-xl text-sm leading-6">
            Used to confirm this commitment and to tell you when the count moves. Withdraw at
            any time from the link in that email.
          </p>

          <button type="submit" class="ink-button mt-9">
            Commit <span aria-hidden="true">↗</span>
          </button>
        </div>
      </form>
    </div>
  </section>
</Layouts.app>
